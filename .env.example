# Copy to .env for local runs. In GitHub Actions these come from repo Secrets.

# --- OANDA (spot XAU/USD, FX, index CFDs — tick-volume feed) ---
# Create a token at https://www.oanda.com (My Account -> Manage API Access)
OANDA_API_KEY=
# "practice" (fxTrade Practice) or "live"
OANDA_ENV=practice

# --- CME / COMEX (centralized true volume for GC futures) ---
# Requires a licensed market-data endpoint that serves trades with aggressor
# flags (e.g. CME DataMine / a redistributor). Leave blank to skip GC footprint.
CME_API_URL=
CME_API_KEY=

# --- Interactive Brokers Client Portal gateway (optional, local only) ---
IBKR_GATEWAY_URL=https://localhost:5000/v1/api

# --- Engine tuning (optional; sensible defaults apply) ---
# REST requests allowed per minute (token bucket)
REQUESTS_PER_MINUTE=60
# Output file for appended snapshot blocks
OUTPUT_FILE=market_updates.txt
